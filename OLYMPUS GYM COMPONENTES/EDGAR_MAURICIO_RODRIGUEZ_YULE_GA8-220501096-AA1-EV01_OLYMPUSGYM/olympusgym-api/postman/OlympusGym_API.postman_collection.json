    {
      "name": "CP-03 Resumen del dashboard",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dashboard/stats" },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Estado 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Respuesta JSON', () => pm.response.to.be.json);",
            "var responseJson = pm.response.json();",
            "pm.test('Contiene indicadores', () => { ['totalUsuarios','totalClientes','totalRutinas','totalIngresos'].forEach(k => pm.expect(responseJson).to.have.property(k)); });",
            "pm.test('Valores numéricos', () => Object.values(responseJson).forEach(v => pm.expect(v).to.be.a('number')));"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "CP-04 Asignar plan alimenticio",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": { \"id\": {{usuarioId}} },\n  \"titulo\": \"Definición 8 semanas\",\n  \"objetivo\": \"Definición\",\n  \"descripcion\": \"Plan para perder grasa preservando masa muscular\",\n  \"calorias\": 2000,\n  \"proteinas\": 180,\n  \"carbohidratos\": 150,\n  \"grasas\": 50,\n  \"fechaInicio\": \"2026-08-14\",\n  \"fechaFin\": \"2026-10-09\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/planes/asignar"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Estado 201 Created', () => pm.response.to.have.status(201));",
            "var responseJson = pm.response.json();",
            "pm.test('Plan creado con id', () => pm.expect(responseJson.id).to.be.a('number'));",
            "pm.test('Asociado al usuario', () => pm.expect(responseJson.usuario.id).to.eql(Number(pm.environment.get('usuarioId'))));",
            "pm.test('Calorías correctas', () => pm.expect(responseJson.calorias).to.eql(2000));"
          ],
          "type": "text/javascript"
        }
      }]
    },
