    {
      "name": "CP-08 Consultar planes por usuario",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/planes/usuario/{{usuarioId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Estado 200 OK', () => pm.response.to.have.status(200));",
            "var responseJson = pm.response.json();",
            "pm.test('Respuesta es arreglo', () => pm.expect(responseJson).to.be.an('array').and.not.empty);",
            "pm.test('Planes pertenecen al usuario', () => responseJson.forEach(p => pm.expect(p.usuario.id).to.eql(Number(pm.environment.get('usuarioId')))));",
            "pm.test('Incluye plan creado', () => pm.expect(responseJson.some(p => p.titulo === 'Definición 8 semanas')).to.be.true);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "CP-09 Consultar rutinas por usuario",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/rutinas/usuario/{{usuarioId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Estado 200 OK', () => pm.response.to.have.status(200));",
            "var responseJson = pm.response.json();",
            "pm.test('Respuesta es arreglo', () => pm.expect(responseJson).to.be.an('array').and.not.empty);",
