{
  "info": {
    "_postman_id": "5a091c8b-2518-4654-b6e6-olympusgym-api",
    "name": "OlympusGym API — Node.js + Express",
    "description": "Validación reproducible de los módulos integrados de OlympusGym para GA8-220501096-AA1-EV01. Colección ejecutada contra Express en localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CP-01 Registro de usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"María González\",\n  \"email\": \"{{emailDemo}}\",\n  \"password\": \"{{passwordDemo}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Crea el usuario cliente que se emplea en los casos siguientes."
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Estado 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Respuesta JSON', () => pm.response.to.be.json);",
            "var responseJson = pm.response.json();",
            "pm.test('Usuario creado con id', () => pm.expect(responseJson.id).to.be.a('number'));",
            "pm.test('No expone password', () => { pm.expect(responseJson).not.to.have.property('password'); pm.expect(responseJson).not.to.have.property('passwordHash'); });",
            "pm.test('Token generado', () => pm.expect(responseJson.token).to.be.a('string').and.not.empty);",
            "pm.environment.set('usuarioId', String(responseJson.id));",
            "pm.environment.set('token', responseJson.token);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "CP-02 Inicio de sesión",
      "request": {
