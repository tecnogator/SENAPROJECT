    {
      "name": "CN-01 Registro con email duplicado",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombreCompleto\": \"María Duplicada\",\n  \"email\": \"{{emailDemo}}\",\n  \"password\": \"{{passwordDemo}}\"\n}" },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Estado 409 Conflict', () => pm.response.to.have.status(409));",
        "pm.test('Código EMAIL_ALREADY_EXISTS', () => pm.expect(pm.response.json().error).to.eql('EMAIL_ALREADY_EXISTS'));"
      ], "type": "text/javascript" } }]
    },
    {
      "name": "CN-02 Login con contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailDemo}}\",\n  \"password\": \"incorrecta\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Estado 401 Unauthorized', () => pm.response.to.have.status(401));",
        "pm.test('No expone datos privados', () => pm.expect(pm.response.text()).not.to.include('passwordHash'));"
      ], "type": "text/javascript" } }]
    },
    {
      "name": "CN-03 Rutina con campo obligatorio ausente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"usuario\": { \"id\": {{usuarioId}} },\n  \"dia\": \"Martes\",\n  \"series\": 3,\n  \"repeticiones\": 10\n}" },
        "url": "{{baseUrl}}/api/rutinas/asignar"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Estado 400 Bad Request', () => pm.response.to.have.status(400));",
        "pm.test('Detalla el campo ejercicio', () => pm.expect(pm.response.text()).to.include('ejercicio'));"
      ], "type": "text/javascript" } }]
